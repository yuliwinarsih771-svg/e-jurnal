{
  "entities": {
    "Pegawai": {
      "title": "Pegawai",
      "description": "Data pegawai instansi ASN/PPPK/Non-ASN beserta peran dan kredensial",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "nip": { "type": "string" },
        "username": { "type": "string" },
        "jabatan": { "type": "string" },
        "unitKerja": { "type": "string" },
        "pangkatGolongan": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["pegawai", "atasan", "admin", "superadmin"] },
        "password": { "type": "string" },
        "foto": { "type": "string" },
        "atasanId": { "type": "string" },
        "noHp": { "type": "string" }
      },
      "required": ["id", "nama", "nip", "jabatan", "unitKerja", "role"]
    },
    "KegiatanJurnal": {
      "title": "KegiatanJurnal",
      "description": "Catatan aktivitas harian kinerja pegawai",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pegawaiId": { "type": "string" },
        "tanggal": { "type": "string" },
        "hari": { "type": "string" },
        "nomorKegiatan": { "type": "string" },
        "waktuMulai": { "type": "string" },
        "waktuSelesai": { "type": "string" },
        "kegiatan": { "type": "string" },
        "outputHasil": { "type": "string" },
        "statusValidasi": { "type": "string", "enum": ["Menunggu", "Disetujui", "Ditolak"] },
        "catatanAtasan": { "type": "string" },
        "tanggalValidasi": { "type": "string" },
        "namaValidator": { "type": "string" },
        "nipValidator": { "type": "string" },
        "tautanBukti": { "type": "string" }
      },
      "required": ["id", "pegawaiId", "tanggal", "waktuMulai", "waktuSelesai", "kegiatan", "outputHasil", "statusValidasi"]
    },
    "PresensiRecord": {
      "title": "PresensiRecord",
      "description": "Rekap data kehadiran harian pegawai",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pegawaiId": { "type": "string" },
        "tanggal": { "type": "string" },
        "hari": { "type": "string" },
        "jamMasuk": { "type": "string" },
        "jamPulang": { "type": "string" },
        "status": { "type": "string", "enum": ["Hadir", "WFH", "Dinas Luar", "Izin", "Sakit", "Cuti"] },
        "keterangan": { "type": "string" },
        "lokasi": { "type": "string" },
        "terlambatMenit": { "type": "number" },
        "fotoBukti": { "type": "string" }
      },
      "required": ["id", "pegawaiId", "tanggal", "jamMasuk", "status"]
    },
    "PengaturanInstansi": {
      "title": "PengaturanInstansi",
      "description": "Konfigurasi identitas dinas, kop surat, logo, dan pejabat penilai",
      "type": "object",
      "properties": {
        "namaInstansi": { "type": "string" },
        "badanDinas": { "type": "string" },
        "bidangBagian": { "type": "string" },
        "alamat": { "type": "string" },
        "kotaPenetapan": { "type": "string" },
        "logoUrl": { "type": "string" },
        "judulDokumen": { "type": "string" },
        "subJudulDokumen": { "type": "string" },
        "namaAtasan": { "type": "string" },
        "nipAtasan": { "type": "string" },
        "jabatanAtasan": { "type": "string" },
        "pangkatAtasan": { "type": "string" },
        "jamMasukNormal": { "type": "string" },
        "jamPulangNormal": { "type": "string" },
        "toleransiKeterlambatanMenit": { "type": "number" }
      },
      "required": ["namaInstansi", "badanDinas", "alamat", "kotaPenetapan", "judulDokumen", "namaAtasan", "nipAtasan"]
    },
    "LampiranBukti": {
      "title": "LampiranBukti",
      "description": "Dokumen/foto/tautan bukti kinerja pendukung kegiatan (One-to-Many dengan KegiatanJurnal)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kegiatanId": { "type": "string" },
        "judul": { "type": "string" },
        "url": { "type": "string" },
        "tipe": { "type": "string", "enum": ["link", "gambar", "dokumen"] },
        "waktuDibuat": { "type": "string" }
      },
      "required": ["id", "kegiatanId", "judul", "url"]
    },
    "SubAktivitas": {
      "title": "SubAktivitas",
      "description": "Rincian tugas atau sub-output dari kegiatan harian (One-to-Many dengan KegiatanJurnal)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kegiatanId": { "type": "string" },
        "uraian": { "type": "string" },
        "status": { "type": "string", "enum": ["Selesai", "Dalam Proses", "Pending"] },
        "targetOutput": { "type": "string" }
      },
      "required": ["id", "kegiatanId", "uraian", "status"]
    }
  },
  "firestore": {
    "/pegawai/{pegawaiId}": {
      "schema": "Pegawai",
      "description": "Daftar pegawai dan akun pengguna"
    },
    "/pegawai/{pegawaiId}/jurnal_harian/{jurnalId}": {
      "schema": "KegiatanJurnal",
      "description": "One-to-Many subcollection: Log kegiatan harian spesifik per pegawai"
    },
    "/pegawai/{pegawaiId}/presensi/{presensiId}": {
      "schema": "PresensiRecord",
      "description": "One-to-Many subcollection: Rekam jejak kehadiran harian per pegawai"
    },
    "/pegawai/{pegawaiId}/jurnal_harian/{jurnalId}/lampiran/{lampiranId}": {
      "schema": "LampiranBukti",
      "description": "One-to-Many subcollection: Lampiran/bukti kegiatan per kegiatan jurnal pegawai"
    },
    "/pegawai/{pegawaiId}/jurnal_harian/{jurnalId}/sub_aktivitas/{subId}": {
      "schema": "SubAktivitas",
      "description": "One-to-Many subcollection: Rincian sub-aktivitas per kegiatan jurnal pegawai"
    },
    "/jurnal_harian/{jurnalId}": {
      "schema": "KegiatanJurnal",
      "description": "Catatan log kegiatan harian pegawai (koleksi utama dengan relasi pegawaiId)"
    },
    "/jurnal_harian/{jurnalId}/lampiran/{lampiranId}": {
      "schema": "LampiranBukti",
      "description": "One-to-Many subcollection: Daftar lampiran bukti per kegiatan jurnal"
    },
    "/jurnal_harian/{jurnalId}/sub_aktivitas/{subId}": {
      "schema": "SubAktivitas",
      "description": "One-to-Many subcollection: Rincian sub-tugas per kegiatan jurnal"
    },
    "/presensi/{presensiId}": {
      "schema": "PresensiRecord",
      "description": "Rekam jejak kehadiran harian"
    },
    "/pengaturan/{docId}": {
      "schema": "PengaturanInstansi",
      "description": "Pengaturan instansi dan profil cetak per akun atau templat baku"
    },
    "/atasan/{atasanId}/bawahan/{bawahanId}": {
      "schema": "Pegawai",
      "description": "One-to-Many relasi: Daftar bawahan langsung yang dinilai oleh atasan"
    }
  }
}
