rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pegawai/{pegawaiId} {
      allow read, write: if true;
    }
    match /jurnal_harian/{jurnalId} {
      allow read, write: if true;
    }
    match /presensi/{presensiId} {
      allow read, write: if true;
    }
    match /pengaturan/{docId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
